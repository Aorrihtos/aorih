---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { BlogPost } from '@/domain/blog-post';
import { formatDay } from '@/lib/format-date';
import { blogRepository } from '@/repositories';

export const getStaticPaths = (async () => {
  const summaries = await blogRepository.getAll();
  const posts = await Promise.all(summaries.map(({ slug }) => blogRepository.getBySlug(slug)));

  return posts
    .filter((post): post is BlogPost => post !== null)
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.description}>
  <div class="container">
    <article class="post">
      <h1>{post.title}</h1>
      <p class="blog-meta">
        <time datetime={post.publishedAt}>{formatDay(post.publishedAt)}</time>
      </p>
      {
        post.tags.length > 0 && (
          <ul class="blog-tags">
            {post.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <div class="post-body" set:html={post.html} />
    </article>
  </div>
</BaseLayout>
