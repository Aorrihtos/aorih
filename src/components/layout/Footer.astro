---
import { siteSettingsRepository } from '@/repositories';
import { calculateBirthdayProgress, calculateLevel, rollStat } from '@/lib/player-stats';

const settings = await siteSettingsRepository.get();

// Rendered at build time so the bars are never empty; the script below re-rolls
// HP/AP and recomputes LEVEL on each visit, since the page itself is static.
const hp = rollStat(settings.hp);
const ap = rollStat(settings.ap);
const level = calculateLevel(settings.birthDate);
const birthdayProgress = calculateBirthdayProgress(settings.birthDate);
---

<footer>
  <slot name="lead" />
  <div
    class="footer-bars"
    data-player-stats
    data-birth-date={settings.birthDate}
    data-hp-min={settings.hp.min}
    data-hp-max={settings.hp.max}
    data-ap-min={settings.ap.min}
    data-ap-max={settings.ap.max}
  >
    <div class="bar hp">HP <span data-hp>{hp}</span>/{settings.hp.max}</div>
    <div class="bar level">
      LEVEL <span data-level>{level}</span>
      <div
        class="level-progress"
        role="progressbar"
        aria-label="Progress to next birthday"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={birthdayProgress}
        data-birthday-progress
      >
        <div class="level-progress-fill" style={`width: ${birthdayProgress}%`}></div>
      </div>
    </div>
    <div class="bar ap">AP <span data-ap>{ap}</span>/{settings.ap.max}</div>
  </div>
</footer>

<script>
  import { calculateBirthdayProgress, calculateLevel, rollStat } from '@/lib/player-stats';

  const bars = document.querySelector<HTMLElement>('[data-player-stats]');
  const birthDate = bars?.dataset.birthDate;
  if (bars && birthDate) {
    const range = (min?: string, max?: string) => ({ min: Number(min), max: Number(max) });
    const set = (selector: string, value: string) => {
      const target = bars.querySelector<HTMLElement>(selector);
      if (target) target.textContent = value;
    };

    set('[data-hp]', String(rollStat(range(bars.dataset.hpMin, bars.dataset.hpMax))));
    set('[data-ap]', String(rollStat(range(bars.dataset.apMin, bars.dataset.apMax))));
    set('[data-level]', String(calculateLevel(birthDate)));

    const progress = calculateBirthdayProgress(birthDate);
    const track = bars.querySelector<HTMLElement>('[data-birthday-progress]');
    const fill = track?.firstElementChild;
    if (track && fill instanceof HTMLElement) {
      track.setAttribute('aria-valuenow', String(progress));
      fill.style.width = `${progress}%`;
    }
  }
</script>
