# Keystatic GitHub Mode (production only).
# In development Keystatic uses local storage and none of these are required.
# Create them from the GitHub App generated by Keystatic at /keystatic during the
# first production login, then set them in Netlify > Site settings > Environment variables.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Slug of the GitHub App (public: it is used by the Keystatic UI in the browser).
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
